# ============================================================
# EASM Platform — Core API — переменные окружения
# Скопируй в core/.env и замени все значения
# ============================================================

# ── База данных PostgreSQL ────────────────────────────────────
# Строка подключения для SQLAlchemy asyncpg
# Формат: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://easm:easm_strong_pass@postgres:5432/easm

# ── Redis / Celery ────────────────────────────────────────────
# URL брокера и бэкенда результатов
REDIS_URL=redis://redis:6379/0

# ── OpenSearch ────────────────────────────────────────────────
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX_EVENTS=easm-events

# ── JWT (аутентификация пользователей) ───────────────────────
# ОБЯЗАТЕЛЬНО замени на случайную строку 64+ символов
# Генерация: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_STRING

# Алгоритм подписи JWT (по умолчанию HS256)
ALGORITHM=HS256

# Время жизни токена в минутах
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Внутренний shared secret (воркеры -> Core API) ────────────
# Используется для аутентификации запросов от Celery-воркеров
# ОБЯЗАТЕЛЬНО замени на случайную строку
# Генерация: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_SECRET=REPLACE_WITH_RANDOM_INTERNAL_SECRET

# ── Первый суперпользователь ──────────────────────────────────
# Создаётся автоматически при первом запуске
FIRST_SUPERUSER_EMAIL=admin@yourdomain.com
FIRST_SUPERUSER_PASSWORD=strong_admin_password_here

# ── GitHub (опционально) ──────────────────────────────────────
# Токен для поиска утечек в публичных репозиториях GitHub
# Без токена: rate limit 10 req/min, с токеном: 30 req/min
# Создать: https://github.com/settings/tokens (нужны права: public_repo)
GITHUB_TOKEN=

# ── HaveIBeenPwned (опционально) ─────────────────────────────
# API ключ для проверки email-адресов по базе утечек
# Получить: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# ── Telegram (опционально) ────────────────────────────────────
# Токен бота для алертов о критических находках
# Создать: @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# ── Celery Flower (мониторинг) ────────────────────────────────
# Базовая аутентификация для веб-интерфейса Flower
FLOWER_USER=admin
FLOWER_PASSWORD=change_flower_password

# ── PostgreSQL (для docker-compose) ──────────────────────────
# Используется только в docker-compose.yml
POSTGRES_PASSWORD=easm_strong_pass

# ── Shodan Enrichment (задача 9.J, опционально) ───────────────
# Asset Drift: исторические открытые порты по данным Shodan.
# Бесплатный план: 1 запрос/секунда, 100 запросов/месяц.
# Без ключа — enrichment gracefully skipped (не ошибка).
# Получить: https://account.shodan.io/
SHODAN_API_KEY=

# ── Censys Enrichment (задача 9.J, опционально) ───────────────
# Альтернатива Shodan для TLS/сервисной разведки.
# Получить: https://search.censys.io/account/api
CENSYS_API_ID=
CENSYS_API_SECRET=
