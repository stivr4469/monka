# Скопируй в .env и замени значения

# PostgreSQL
POSTGRES_PASSWORD=easm_strong_pass

# JWT
SECRET_KEY=replace_with_a_random_64_char_string

# Ключ для воркеров → Core API (shared secret)
INTERNAL_API_SECRET=replace_with_random_secret

# Первый суперпользователь
FIRST_SUPERUSER_EMAIL=admin@yourdomain.com
FIRST_SUPERUSER_PASSWORD=strong_admin_password
