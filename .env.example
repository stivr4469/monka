# ============================================================
# EASM Platform — корневой .env для docker-compose
# Скопируй в .env и замени все значения
# cp .env.example .env
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_PASSWORD=easm_strong_pass

# ── JWT (FastAPI Core) ────────────────────────────────────────
# Генерация: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_STRING

# ── Shared secret (воркеры -> Core API) ──────────────────────
# Генерация: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_SECRET=REPLACE_WITH_RANDOM_INTERNAL_SECRET

# ── Первый суперпользователь ──────────────────────────────────
FIRST_SUPERUSER_EMAIL=admin@yourdomain.com
FIRST_SUPERUSER_PASSWORD=strong_admin_password_here

# ── GitHub поиск (опционально) ───────────────────────────────
GITHUB_TOKEN=

# ── HaveIBeenPwned (опционально) ─────────────────────────────
HIBP_API_KEY=

# ── Telegram алерты (опционально) ────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Flower — мониторинг Celery (порт 5555) ───────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=change_flower_password
